# Copy to .env and set your key. .env is git-ignored. Never commit keys.
ANTHROPIC_API_KEY=
# Optional
CLAUDE_MODEL=claude-sonnet-4-5
PORT=3000

# Optional: route every Claude call through an internal LLM gateway instead of api.anthropic.com
# directly (e.g. an org proxy that fronts Anthropic for billing/access control). Assumed to mirror
# Anthropic's own Messages API at POST {GATEWAY_URL}/v1/messages with the same x-api-key header —
# adjust src/claude.js's getApiUrl()/verifyApiKey() if your gateway's actual contract differs.
# When set, CLAUDE_MODEL must be a model name your gateway recognises (it may not accept
# Anthropic's native model ids), and the "Connect Claude" key format check is relaxed since a
# gateway token isn't necessarily shaped like sk-ant-...
# GATEWAY_URL=https://your-internal-gateway.example.com/
# CLAUDE_MODEL=claude-sonnet-5-5-your-gateway-suffix

# Optional: fetch ANTHROPIC_API_KEY from Azure Key Vault at startup instead of setting it above.
# Only used when ANTHROPIC_API_KEY is empty (it's a fallback source, never an override). Needs a
# service principal (app registration) with "get secret" on the vault — the built-in "Key Vault
# Secrets User" RBAC role, or a classic access policy with Get on secrets.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_KEY_VAULT_URL=https://<your-vault-name>.vault.azure.net
# AZURE_SECRET_NAME=anthropic-api-key
